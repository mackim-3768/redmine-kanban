<div class="kanban-card priority-<%= issue.priority.try(:position) %>"
     draggable="true"
     data-issue-id="<%= issue.id %>"
     data-col-key="<%= col_key %>"
     data-status-id="<%= issue.status_id %>"
     title="<%= issue.status.name %>">
  <div class="kb-card-top">
    <span class="kb-tracker tracker-<%= issue.tracker_id %>"><%= issue.tracker.name %></span>
    <span class="kb-id">#<%= issue.id %></span>
  </div>
  <div class="kb-subject">
    <%= link_to issue.subject, issue_path(issue), title: issue.subject %>
  </div>
  <div class="kb-card-meta">
    <% if issue.assigned_to %>
      <span class="kb-assignee" title="<%= issue.assigned_to.name %>">
        <%= avatar(issue.assigned_to, size: 16) if respond_to?(:avatar) %>
        <%= issue.assigned_to.name.split.first %>
      </span>
    <% end %>
    <% if issue.fixed_version %>
      <span class="kb-version"><%= issue.fixed_version.name %></span>
    <% end %>
    <% if issue.due_date %>
      <span class="kb-due <%= 'overdue' if issue.overdue? %>"><%= format_date(issue.due_date) %></span>
    <% end %>
  </div>
  <% if issue.done_ratio && issue.done_ratio > 0 %>
    <div class="kb-progress"><span style="width: <%= issue.done_ratio %>%"></span></div>
  <% end %>
</div>
